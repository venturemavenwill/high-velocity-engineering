# The build context is the repository root. The server reads the public Markdown
# substrate as well as graph.json, but local copyrighted source material and
# development-only files must not enter the image.

.git
.github
.vscode
node_modules
**/node_modules

# Local copyrighted source material is never deployed.
raw

# Build and deployment tooling is not needed at runtime.
scripts
infra

# Derived, but only graph.json is read at runtime.
graph/*.jsonl
graph/stats.json

# Local-only tooling
mcp/hve-iq/smoke.js
mcp/hve-iq/Dockerfile
